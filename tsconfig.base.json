{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    // ES2022 rather than the legacy app's `es5`. BigInt literals need ES2020+,
    // and money is a branded bigint (docs/plans/M1.md D1), so this is
    // load-bearing rather than housekeeping.
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    // `ignoreBuildErrors` is gone for good. Everything below is what makes the
    // port surface the holes rather than carry them across (ADR-0011).
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,

    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  }
}
