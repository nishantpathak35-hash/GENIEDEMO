node_modules/
.pnpm-store/
.next/
out/
dist/
build/
# docs/design/build/ is the design set's generator — source, not output (docs/design/README.md)
!docs/design/build/
coverage/
.turbo/
.vercel/

.env
.env.*
!.env.example

*.sqlite
*.sqlite-*
*.db

*.log
npm-debug.log*
.DS_Store
Thumbs.db
.idea/
.vscode/

# Claude Code per-machine overrides — never shared
.claude/settings.local.json

# Session prompts — working notes, not part of the record
docs/prompts/
e2e/report/
e2e/results/

# Regenerated by `next dev` on every run. Tracking it means every gate run
# leaves a dirty tree and every commit risks staging a file nobody edited.
apps/*/next-env.d.ts

# The design-system gallery is rendered by its stories test on every run.
packages/design-system/stories/gallery/

# `next dev` writes these into an app when it detects an AI coding agent in the
# environment. The guidance this repo wants read is its own CLAUDE.md, not a
# generated one; keep them out of the tree.
apps/*/AGENTS.md
apps/*/CLAUDE.md

# a Python linter cache a session left behind in docs/design once (19 September 2026)
.ruff_cache/
# the no-API copies' own .next, kept warm between gate runs (scripts/e2e.mjs 3b)
.e2e/
